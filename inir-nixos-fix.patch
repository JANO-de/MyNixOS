diff --git a/modules/home/niri.nix b/modules/home/niri.nix
index e9b06ff..941cebb 100644
--- a/modules/home/niri.nix
+++ b/modules/home/niri.nix
@@ -7,14 +7,29 @@
 }:
 
 let
+  # Import path niri needs to hand `qs -c inir` so it can find
+  # org.kde.syntaxhighlighting / kirigami / qt5compat / qtpositioning QML
+  # modules. Baking this into the spawn line itself (rather than relying on
+  # home.sessionVariables reaching niri's spawned children, which isn't
+  # guaranteed depending on how the session was started) is what actually
+  # fixes the "module org.kde.syntaxhighlighting is not installed" crash.
+  inirQmlImportPath = lib.concatStringsSep ":" [
+    "${pkgs.qt6.qt5compat}/lib/qt-6/qml"
+    "${pkgs.qt6.qtpositioning}/lib/qt-6/qml"
+    "${pkgs.kdePackages.syntax-highlighting}/lib/qt-6/qml"
+    "${pkgs.kdePackages.kirigami.unwrapped}/lib/qt-6/qml"
+  ];
+  qsInirLaunch = "QML_IMPORT_PATH=${inirQmlImportPath} QT_QPA_PLATFORM=wayland exec ${pkgs.quickshell}/bin/qs -c inir";
+
   # Inject theme colors and Tide Island store paths into the static KDL template
   content = lib.replaceStrings
-    [ "@FOCUS@" "@FOCUS_INACTIVE@" "@QUICKSHELL_BIN@" "@TIDE_QML_DIR@" ]
+    [ "@FOCUS@" "@FOCUS_INACTIVE@" "@QUICKSHELL_BIN@" "@TIDE_QML_DIR@" "@QS_INIR_LAUNCH@" ]
     [
       (theme.color "accent")
       (theme.color "surface")
       "${pkgs.quickshell}/bin/quickshell"
       "${pkgs.tide-island}/share/tide-island"
+      qsInirLaunch
     ]
     (builtins.readFile ./niri/config.kdl);
 in
