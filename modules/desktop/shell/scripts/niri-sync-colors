#!/usr/bin/env bash
# Adapted from temp/inir-nixos/scripts/niri-sync-colors for this flake.
#
# The reference edits ~/.config/niri/config.kdl directly; that file is a
# read-only home-manager store symlink here, so the niri focus-ring sync runs
# against a writable copy under $XDG_CACHE_HOME/niri when possible and is
# skipped (with a logged warning) otherwise. The wallpaper-path sync into the
# shell config always runs.
set -Eeuo pipefail

XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
COLORS_JSON="$HOME/.local/state/quickshell/user/generated/colors.json"
META_JSON="$HOME/.local/state/quickshell/user/generated/theme-meta.json"
GENERATED_DIR="$HOME/.local/state/quickshell/user/generated"
SHELL_CONFIG_FILE="$HOME/.config/illogical-impulse/config.json"
NIRI_CONFIG_KDL="$HOME/.config/niri/config.kdl"
NIRI_SYNC_COPY="$XDG_CACHE_HOME/niri/config.kdl"
PYTHON="python3"
# The reference copies niri-config.py to ~/.config/quickshell/inir/scripts;
# a declarative install must point here via NIRI_CONFIG_PY (set in inir.nix) or
# fall back to the store path of the inir package when it's on PATH.
NIRI_CONFIG_PY="${NIRI_CONFIG_PY:-$HOME/.config/quickshell/inir/scripts/niri-config.py}"

# niri-config.py writes in place; give it a writable copy of the (symlinked,
# read-only) config.kdl when available, otherwise skip the niri half.
prepare_niri_copy() {
    [[ -f "$NIRI_CONFIG_KDL" ]] || return 1
    [[ -f "$NIRI_CONFIG_PY" ]] || return 1

    if [[ ! -w "$NIRI_CONFIG_KDL" ]]; then
        mkdir -p "$(dirname "$NIRI_SYNC_COPY")"
        if cp "$NIRI_CONFIG_KDL" "$NIRI_SYNC_COPY.tmp" 2>/dev/null; then
            # Point niri-config.py at the writable copy. We cannot atomically
            # overwrite the home-manager symlink itself, so niri-config.py
            # edits the copy and we leave the live config.kdl untouched.
            NIRI_CONFIG_KDL="$NIRI_SYNC_COPY.tmp"
            return 0
        fi
        return 1
    fi
}

sync_once() {
    [[ -f "$COLORS_JSON" ]] || return 0

    command -v "$PYTHON" >/dev/null 2>&1 || {
        echo "niri-sync-colors: python3 not found" >&2
        return 1
    }

    command -v jq >/dev/null 2>&1 || {
        echo "niri-sync-colors: jq not found" >&2
        return 1
    }

    local primary
    local secondary

    primary="$(jq -er '.primary | strings' "$COLORS_JSON")"
    secondary="$(jq -er '.secondary | strings' "$COLORS_JSON")"

    if prepare_niri_copy; then
        "$PYTHON" "$NIRI_CONFIG_PY" \
            set layout focus-ring.active-color "$primary" || true
        "$PYTHON" "$NIRI_CONFIG_PY" \
            set layout focus-ring.inactive-color "$secondary" || true
    else
        echo "niri-sync-colors: niri config.kdl is not writable; skipping niri color sync (theme colors still apply from config.kdl)" >&2
    fi

    if [[ -f "$META_JSON" && -f "$SHELL_CONFIG_FILE" ]]; then
        local wallpaper_path
        wallpaper_path="$(jq -r '.source_path // empty' "$META_JSON")"

        if [[ -n "$wallpaper_path" ]]; then
            local lockfile
            local tmpfile

            lockfile="$SHELL_CONFIG_FILE.lock"
            tmpfile="${SHELL_CONFIG_FILE}.tmp.$$"

            if (
                flock -w 5 200 || exit 1

                jq --arg path "$wallpaper_path" \
                    '.background.wallpaperPath = $path' \
                    "$SHELL_CONFIG_FILE" > "$tmpfile"

                mv -f "$tmpfile" "$SHELL_CONFIG_FILE"
            ) 200>"$lockfile"; then
                :
            else
                rm -f "$tmpfile"
                echo "niri-sync-colors: could not update wallpaper path" >&2
            fi
        fi
    fi
}

case "${1:-}" in
    "")
        sync_once
        ;;

    --watch)
        command -v inotifywait >/dev/null 2>&1 || {
            echo "niri-sync-colors: inotifywait not found" >&2
            exit 1
        }

        while [[ ! -d "$GENERATED_DIR" ]]; do
            sleep 2
        done

        sync_once

        inotifywait -m \
            -e close_write,moved_to \
            --format '%f' \
            "$GENERATED_DIR" |
        while read -r file; do
            case "$file" in
                colors.json|theme-meta.json)
                    sync_once || echo "niri-sync-colors: sync failed, will retry on next event" >&2
                    ;;
            esac
        done
        ;;

    --help|-h)
        cat <<'HELP'
Usage:
  niri-sync-colors
  niri-sync-colors --watch

Synchronizes iNiR/Quickshell colors with Niri and keeps
the iNiR wallpaper path in sync with theme metadata.
HELP
        ;;

    *)
        echo "Usage: niri-sync-colors [--watch]" >&2
        exit 2
        ;;
esac