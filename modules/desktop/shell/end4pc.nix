# =============================================================================
#  end4-pC (Quickshell, fork of illogical-impulse) as the niri shell.
#  Off by default. Enable (e.g. in hosts/desktop/default.nix):
#      modules.desktop.end4pc.enable = true;
#  It replaces dynisland's autostart (dynisland stays installed, just not
#  started) and adds niri binds via ~/.config/niri/config.d/20-end4pc.kdl.
#  Source: flake input `end4-pc`, copied once to ~/.config/quickshell/end4-pC
#  (editable). To re-sync from the flake: rm -r that folder, re-login.
# =============================================================================
{ config, pkgs, lib, inputs, ... }:
let
  cfg = config.modules.desktop.end4pc;
  qt = pkgs.kdePackages;

  # Scripts do `source $ILLOGICAL_IMPULSE_VIRTUAL_ENV/bin/activate`
  py = pkgs.python3.withPackages (ps:
    (with ps; [ numpy opencv4 pillow pygobject3 tqdm loguru pip setuptools wheel ])
    ++ lib.optional (ps ? materialyoucolor) ps.materialyoucolor);
  needPip = !(pkgs.python3Packages ? materialyoucolor);

  venv = pkgs.writeTextDir "bin/activate" ''
    export PATH=${py}/bin:$PATH
    export PYTHONPATH="$HOME/.local/state/quickshell/ii-pylibs''${PYTHONPATH:+:$PYTHONPATH}"
  '';

  pipScript = pkgs.writeShellScript "end4pc-pylibs" ''
    T="$HOME/.local/state/quickshell/ii-pylibs"
    PYTHONPATH="$T" ${py}/bin/python -c "import materialyoucolor" 2>/dev/null \
      || LD_LIBRARY_PATH=${lib.makeLibraryPath [ pkgs.stdenv.cc.cc.lib ]} \
         ${py}/bin/python -m pip install --quiet --target "$T" materialyoucolor || true
  '';

  qmlPath = lib.makeSearchPath "lib/qt-6/qml" [
    qt.qt5compat qt.qtdeclarative qt.qtmultimedia qt.qtpositioning
    qt.qtsvg qt.qtwayland qt.syntax-highlighting qt.kirigami
  ];

  runtimeDeps = with pkgs; [
    quickshell niri matugen cava jq libnotify wl-clipboard cliphist grim slurp
    imagemagick ffmpeg wf-recorder mpvpaper playerctl pulseaudio wireplumber
    brightnessctl ddcutil wlsunset tesseract translate-shell songrec
    easyeffects libqalculate ydotool qt.kdialog networkmanager libsecret
    xdg-utils fish bc curl hyprpicker gh coreutils bash findutils gnugrep
    gnused gawk util-linux systemd
  ] ++ [ py ];

  binds = ''
    // end4-pC binds (generated by modules/desktop/shell/end4pc.nix)
    binds {
        Mod+Space   { spawn "qs" "-c" "end4-pC" "ipc" "call" "search" "toggle"; }
        Mod+V       { spawn "qs" "-c" "end4-pC" "ipc" "call" "search" "clipboardToggle"; }
        Mod+A       { spawn "qs" "-c" "end4-pC" "ipc" "call" "sidebarLeft" "toggle"; }
        Mod+N       { spawn "qs" "-c" "end4-pC" "ipc" "call" "sidebarRight" "toggle"; }
        Mod+Comma   { spawn "qs" "-c" "end4-pC" "ipc" "call" "settings" "toggle"; }
        Mod+I       { spawn "qs" "-c" "end4-pC" "ipc" "call" "overlay" "toggle"; }
        Mod+Ctrl+T  { spawn "qs" "-c" "end4-pC" "ipc" "call" "wallpaperSelector" "toggle"; }
        Mod+Alt+T   { spawn "qs" "-c" "end4-pC" "ipc" "call" "wallpaperSelector" "random"; }
        Mod+Shift+L { spawn "qs" "-c" "end4-pC" "ipc" "call" "lock" "activate"; }
        Mod+Shift+Escape { spawn "qs" "-c" "end4-pC" "ipc" "call" "session" "toggle"; }
        Mod+Shift+S { spawn "qs" "-c" "end4-pC" "ipc" "call" "region" "screenshot"; }
        Mod+Shift+X { spawn "qs" "-c" "end4-pC" "ipc" "call" "region" "ocr"; }
        Mod+Alt+R { spawn "qs" "-c" "end4-pC" "ipc" "call" "region" "record"; }
        Mod+Tab     { toggle-overview; }

        XF86MonBrightnessUp   { spawn "qs" "-c" "end4-pC" "ipc" "call" "brightness" "increment"; }
        XF86MonBrightnessDown { spawn "qs" "-c" "end4-pC" "ipc" "call" "brightness" "decrement"; }
    }
  '';
in
{
  options.modules.desktop.end4pc.enable = lib.mkEnableOption
    "end4-pC Quickshell shell on niri (replaces dynisland autostart)";

  config = lib.mkIf cfg.enable {
    services.upower.enable = lib.mkDefault true;
    services.gnome.gnome-keyring.enable = lib.mkDefault true;

    fonts.packages = with pkgs; [ material-symbols rubik nerd-fonts.jetbrains-mono ];

    home-manager.users.jano = { lib, ... }: {
      home.packages = runtimeDeps;

      # editable copy of the source, made once
      home.activation.end4pcSync = lib.hm.dag.entryAfter [ "writeBoundary" ] ''
        D="$HOME/.config/quickshell/end4-pC"
        if [ ! -e "$D/shell.qml" ]; then
          mkdir -p "$D"
          cp -rT --no-preserve=mode ${inputs.end4-pc} "$D"
        fi
      '';

      xdg.configFile."niri/config.d/20-end4pc.kdl".text = binds;

      # only one shell autostarts
      systemd.user.services.dynisland.Install.WantedBy = lib.mkForce [ ];

      systemd.user.services.end4pc = {
        Unit = {
          Description = "end4-pC shell (Quickshell)";
          PartOf = [ "graphical-session.target" ];
          After = [ "graphical-session.target" ];
        };
        Service = {
          ExecStart = "${pkgs.quickshell}/bin/qs -c end4-pC";
          Restart = "on-failure";
          Environment = [
            "ILLOGICAL_IMPULSE_VIRTUAL_ENV=${venv}"
            "QML2_IMPORT_PATH=${qmlPath}"
            "QS_ICON_THEME=Papirus-Dark"
            "XDG_DATA_DIRS=/run/current-system/sw/share:/etc/profiles/per-user/jano/share:%h/.nix-profile/share"
            "PATH=${lib.makeBinPath runtimeDeps}:/run/wrappers/bin:/run/current-system/sw/bin:/etc/profiles/per-user/jano/bin"
          ];
        } // lib.optionalAttrs needPip { ExecStartPre = "${pipScript}"; };
        Install.WantedBy = [ "graphical-session.target" ];
      };
    };
  };
}
