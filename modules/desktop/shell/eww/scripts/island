#!/usr/bin/env bash
# island — controller for the eww island window.
#
#   island init      wait for the eww daemon, then show the collapsed island
#   island expand    grow the island (hover in)
#   island collapse  shrink the island (hover out)
#   island mute      toggle the default sink mute
#
# The state lives in the eww variable `island-open` so the two hover handlers
# (onhover on the collapsed box, onhoverlost on the expanded one) cannot loop:
# each reopens the window under the cursor, which fires the opposite handler,
# but the guard below makes that a no-op.
set -euo pipefail

action="${1:-}"

eww_ready() { eww windows >/dev/null 2>&1; }
is_open() { [ "$(eww get island-open 2>/dev/null || echo false)" = "true" ]; }

case "$action" in
  init)
    for _ in $(seq 1 60); do
      if eww_ready; then break; fi
      sleep 0.1
    done
    eww update island-open=false 2>/dev/null || true
    eww close island 2>/dev/null || true
    eww open island --arg expanded=false || true
    eww open notifications 2>/dev/null || true
    ;;
  expand)
    if is_open; then exit 0; fi
    eww update island-open=true
    eww close island 2>/dev/null || true
    eww open island --arg expanded=true
    ;;
  collapse)
    if is_open; then
      eww update island-open=false
      eww close island 2>/dev/null || true
      eww open island --arg expanded=false
    fi
    ;;
  mute)
    wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
    ;;
  *)
    echo "usage: island {init|expand|collapse|mute}" >&2
    exit 1
    ;;
esac
