;; =============================================================================
;;  Eww ISLAND shell — EVERYTHING lives in this folder.
;;  Wired to the rest of the system by exactly one file:
;;    modules/desktop/shell/eww.nix
;;  which substitutes these placeholders before deploying to ~/.config/eww:
;;    @ISLAND@  -> the island controller script
;;    @NOTIFY@  -> the DBus notification server
;;
;;  Windows:
;;    island         collapsed (day + time) / expanded (controls) at top center
;;    notifications  transient popups                            at top right
;;    osd            volume / brightness overlay                 centered
;;
;;  Tip: the compact controls use plain text labels (VOL/BRI/WIFI/BT/LOCK/PWR).
;;  Swap them for nerd-font glyphs if you prefer icons — the font is already set
;;  to the nerd font in eww.scss.
;; =============================================================================

;; ---------- state ---------------------------------------------------------
;; Mirrors which island state is shown so the `island` guard script does not
;; let onhover -> expand fight onhoverlost -> collapse in an infinite loop.
(defvar island-open "false")

;; OSD content (written by the `osd` script, read by the osd window).
(defvar osd-kind  "Volume")
(defvar osd-value "0")
(defvar osd-icon  "VOL")

;; ---------- data ----------------------------------------------------------
(defpoll clock-day  :interval "30s" `date '+%a %d %b'`)
(defpoll clock-time :interval "5s"  `date '+%H:%M'`)

(defpoll volume     :interval "1s"  `v=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null | awk '{printf "%d", $2*100}'); [ -n "$v" ] || v=0; echo "$v"`)
(defpoll muted      :interval "1s"  `wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null | grep -q MUTED && echo true || echo false`)
(defpoll brightness :interval "2s"  `b=$(brightnessctl -c backlight -m 2>/dev/null | cut -d, -f4 | tr -d '%'); [ -n "$b" ] || b=0; echo "$b"`)
(defpoll battery    :interval "30s" `cat /sys/class/power_supply/BAT*/capacity 2>/dev/null | head -n1`)
(defpoll media      :interval "2s"  `playerctl metadata --format '{{artist}} - {{title}}' 2>/dev/null || true`)

;; Notifications are streamed as a JSON array by the DBus server.
(deflisten notifications :initial "[]" `@NOTIFY@`)

;; ---------- island --------------------------------------------------------
(defwindow island [expanded]
  :monitor 0
  :exclusive false
  :focusable false
  :stacking "overlay"
  :geometry (geometry
              :x "0%"
              :y "6px"
              :width {expanded == "true" ? "660px" : "240px"}
              :height {expanded == "true" ? "170px" : "38px"}
              :anchor "top center")
  (box :class "island-shell"
    ;; ----- collapsed: just day + time -----
    (eventbox :class "island collapsed"
              :visible {expanded != "true"}
              :cursor "pointer"
              :onhover "@ISLAND@ expand"
      (box :class "collapsed-row" :orientation "horizontal" :space-evenly false
        (label :class "day"  :text {clock-day})
        (label :class "time" :text {clock-time})))
    ;; ----- expanded: controls -----
    (eventbox :class "island expanded"
              :visible {expanded == "true"}
              :onhoverlost "@ISLAND@ collapse"
              :timeout "300ms"
      (box :class "expanded-inner" :orientation "vertical" :space-evenly false
        ;; top: now playing (left) ... systray (right)
        (box :class "row" :orientation "horizontal" :space-evenly false
          (label :class "media" :text {media} :truncate true :limit-width 46)
          (box :class "spacer" :hexpand true)
          (systray :class "tray" :icon-size 16))
        ;; middle: volume
        (box :class "row" :orientation "horizontal" :space-evenly false
          (button :class "chip" :onclick "@ISLAND@ mute"
            (label :class "icon" :text {muted == "true" ? "MUTE" : "VOL"}))
          (scale :class "slider" :value volume :min 0 :max 100
            :active true
            :onchange "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ {}%"))
        ;; bottom: brightness + quick toggles
        (box :class "row" :orientation "horizontal" :space-evenly false
          (label :class "icon bri-label" :text "BRI")
          (scale :class "slider" :value brightness :min 1 :max 100
            :active true
            :onchange "brightnessctl -c backlight set {}%")
          (button :class "chip" :onclick "sh -c 'nmcli radio wifi | grep -q enabled && nmcli radio wifi off || nmcli radio wifi on'"
            (label :class "icon" :text "WIFI"))
          (button :class "chip" :onclick "sh -c 'bluetoothctl show | grep -q Powered:.yes && bluetoothctl power off || bluetoothctl power on'"
            (label :class "icon" :text "BT"))
          (button :class "chip" :onclick "swaylock -f"
            (label :class "icon" :text "LOCK"))
          (button :class "chip" :onclick "wlogout --protocol layer-shell --layout @CONFIG@/wlogout/layout --css @CONFIG@/wlogout/style.css"
            (label :class "icon" :text "PWR"))
          (label :class "battery" :text "${battery}%"))))))

;; ---------- notifications -------------------------------------------------
(defwindow notifications
  :monitor 0
  :exclusive false
  :focusable false
  :stacking "overlay"
  :geometry (geometry
              :x "0%"
              :y "6px"
              :width "340px"
              :anchor "top right")
  (box :class "notif-stack" :orientation "vertical" :space-evenly false :valign "start"
    (for n in notifications
      (eventbox :class "notif"
        (box :orientation "horizontal" :space-evenly false
          (box :class "notif-text" :orientation "vertical" :space-evenly false :hexpand true
            (label :class "notif-sum"  :text {n.summary} :truncate true :limit-width 40)
            (label :class "notif-body" :text {n.body}    :truncate true :limit-width 60))
          (button :class "notif-close"
            :onclick "busctl --user call org.freedesktop.Notifications /org/freedesktop/Notifications org.freedesktop.Notifications CloseNotification u ${n.id}"
            (label :text "x")))))))

;; ---------- OSD -----------------------------------------------------------
(defwindow osd
  :monitor 0
  :exclusive false
  :focusable false
  :stacking "overlay"
  :geometry (geometry
              :x "0%"
              :y "10%"
              :width "260px"
              :height "52px"
              :anchor "center")
  (box :class "osd" :orientation "horizontal" :space-evenly false
    (label :class "osd-icon" :text {osd-icon})
    (box :orientation "vertical" :space-evenly false :valign "center"
      (label :class "osd-label" :text {osd-kind})
      (progress :class "osd-bar" :value {osd-value} :width 160))))
