import QtQuick
import qs.config
import qs.services
import qs.components

Page {
    title: "Appearance"

    Text { text: "Wallpaper"; color: Theme.surfaceFgDim; font.pixelSize: 12; topPadding: 4; bottomPadding: 4 }
    WallpaperSlide {}

    SettingRow { label: "Wallpaper folder"; hint: "Images are listed in the slide above"
        Field { text: Config.appearance.wallpaperDir; onAccepted: t => Config.appearance.wallpaperDir = t } }

    SettingRow { label: "Wallpaper per workspace"; hint: "Picking a wallpaper sets it for the active niri workspace only"
        Toggle { checked: Config.appearance.perWorkspace; onToggled: Config.appearance.perWorkspace = !Config.appearance.perWorkspace } }

    SettingRow { label: "Dark mode"
        Toggle { checked: Config.appearance.darkMode; onToggled: Config.appearance.darkMode = !Config.appearance.darkMode } }

    SettingRow { label: "Accent color"; hint: "Auto = from the wallpaper (matugen)" }
    Swatches {
        width: parent.width; current: Config.appearance.accentOverride
        colors: ["", "#a8c7fa", "#f2b8b5", "#8bd5a0", "#f9d56e", "#d0a8ff", "#ffb68a", "#7ee0e0", "#ff8fb1"]
        onPicked: c => Config.appearance.accentOverride = c
    }
    SettingRow { label: "Custom hex"; hint: "#rrggbb, empty = auto"
        Field { text: Config.appearance.accentOverride; placeholder: "#6fd0b4"; onAccepted: t => Config.appearance.accentOverride = t.trim() } }
    SettingRow { label: "Glass opacity"; hint: "Dock and widget cards"
        SSlider { from: 0.2; to: 1; stepSize: 0.05; value: Config.appearance.glassOpacity; onMoved: v => Config.appearance.glassOpacity = v } }

    Text { text: "Style"; color: Theme.surfaceFgDim; font.pixelSize: 12; topPadding: 10; bottomPadding: 4 }
    SettingRow { label: "Glass preset"; hint: "Shared look for the dock, island and this settings window" }
    Chips { width: parent.width; current: Config.appearance.glassPreset
            model: Glass.presetList
            onPicked: v => Config.appearance.glassPreset = v }
    SettingRow { label: "Outline"; visible: Config.appearance.glassPreset === "custom"
        SSlider { from: 0; to: 0.5; stepSize: 0.02; value: Config.appearance.glassOutline; onMoved: v => Config.appearance.glassOutline = v } }
    SettingRow { label: "Sheen"; visible: Config.appearance.glassPreset === "custom"
        SSlider { from: 0; to: 0.3; stepSize: 0.02; value: Config.appearance.glassSheen; onMoved: v => Config.appearance.glassSheen = v } }
    SettingRow { label: "Shadow"; visible: Config.appearance.glassPreset === "custom"
        SSlider { from: 0; to: 0.6; stepSize: 0.02; value: Config.appearance.glassShadow; onMoved: v => Config.appearance.glassShadow = v } }
    SettingRow { label: "Accent tint"; hint: "Mixes the accent color into the glass"; visible: Config.appearance.glassPreset === "custom"
        SSlider { from: 0; to: 1; stepSize: 0.05; value: Config.appearance.glassTint; onMoved: v => Config.appearance.glassTint = v } }
    SettingRow { label: "Wallpaper fit" }
    Chips { width: parent.width; current: Config.appearance.wallpaperFill
            model: [ { label: "Fill (crop)", value: "crop" }, { label: "Fit", value: "fit" }, { label: "Stretch", value: "stretch" } ]
            onPicked: v => Config.appearance.wallpaperFill = v }
    SettingRow { label: "Wallpaper dim"
        SSlider { from: 0; to: 0.8; stepSize: 0.05; value: Config.appearance.wallpaperDim; onMoved: v => Config.appearance.wallpaperDim = v } }
    SettingRow { label: "Color scheme"; hint: "Material-You variant generated by matugen" }
    Chips {
        width: parent.width
        current: Config.appearance.scheme
        model: [ { label: "Tonal spot", value: "scheme-tonal-spot" }, { label: "Vibrant", value: "scheme-vibrant" },
                 { label: "Expressive", value: "scheme-expressive" }, { label: "Fruit salad", value: "scheme-fruit-salad" },
                 { label: "Rainbow", value: "scheme-rainbow" }, { label: "Content", value: "scheme-content" },
                 { label: "Monochrome", value: "scheme-monochrome" } ]
        onPicked: v => Config.appearance.scheme = v
    }

    SettingRow { label: "Current palette" ; hint: "primary / secondary / tertiary / surface"
        Repeater {
            model: [Theme.primary, Theme.secondary, Theme.tertiary, Theme.surfaceContainerHigh]
            Rectangle { required property color modelData; width: 34; height: 34; radius: 17; color: modelData
                        border.width: 1; border.color: Theme.outline }
        }
    }
}
