import QtQuick
import qs.config
import qs.services
import qs.components

Page {
    title: "Appearance"

    Text { text: "Wallpaper"; color: Theme.onSurfaceVariant; font.pixelSize: 12; topPadding: 4; bottomPadding: 4 }
    WallpaperSlide {}

    SettingRow { label: "Wallpaper folder"; hint: "Images are listed in the slide above"
        Field { text: Config.appearance.wallpaperDir; onAccepted: t => Config.appearance.wallpaperDir = t } }

    SettingRow { label: "Dark mode"
        Toggle { checked: Config.appearance.darkMode; onToggled: Config.appearance.darkMode = !Config.appearance.darkMode } }

    SettingRow { label: "Color scheme"; hint: "Material-You variant generated by matugen" }
    Chips {
        width: parent.width
        current: Config.appearance.scheme
        model: [ { label: "Tonal spot", value: "scheme-tonal-spot" }, { label: "Vibrant", value: "scheme-vibrant" },
                 { label: "Expressive", value: "scheme-expressive" }, { label: "Fruit salad", value: "scheme-fruit-salad" },
                 { label: "Rainbow", value: "scheme-rainbow" }, { label: "Content", value: "scheme-content" },
                 { label: "Monochrome", value: "scheme-monochrome" } ]
        onPicked: v => Config.appearance.scheme = v
    }

    SettingRow { label: "Current palette" ; hint: "primary / secondary / tertiary / surface"
        Repeater {
            model: [Theme.primary, Theme.secondary, Theme.tertiary, Theme.surfaceContainerHigh]
            Rectangle { required property color modelData; width: 34; height: 34; radius: 17; color: modelData
                        border.width: 1; border.color: Theme.outline }
        }
    }
}
