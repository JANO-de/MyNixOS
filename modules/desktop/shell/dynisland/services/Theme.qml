// =============================================================================
//  Theme — Material-You colors generated with `matugen` from the accent color,
//  else the wallpaper, else a default seed. Re-runs when any of them, dark mode or scheme change. Defaults are used until
//  matugen succeeds.
//
//  USE: color: Theme.primary.   TO ADD A COLOR: add a property + a set() line.
// =============================================================================
pragma Singleton
import QtQuick
import Quickshell
import Quickshell.Io
import qs.config

Singleton {
    id: root

    // generated by matugen; `primary` can be overridden from Settings > Appearance
    property color genPrimary: "#a8c7fa"
    property color genPrimaryFg: "#062e6f"
    readonly property string accentOverride: Config.appearance.accentOverride
    readonly property bool overridden: /^#[0-9a-fA-F]{6}$/.test(accentOverride)
    property color primary: overridden ? accentOverride : genPrimary
    property color primaryFg: overridden ? (Qt.color(accentOverride).hslLightness > 0.55 ? "#101010" : "#ffffff") : genPrimaryFg
    property color secondary: "#bec6dc"
    property color tertiary: "#dabde2"
    property color surface: "#111318"
    property color surfaceContainer: "#1d2024"
    property color surfaceContainerHigh: "#282a2f"
    property color surfaceFg: "#e2e2e9"
    property color surfaceFgDim: "#c4c6d0"
    property color outline: "#8e9099"

    Behavior on primary { ColorAnimation { duration: 400 } }
    Behavior on surface { ColorAnimation { duration: 400 } }

    readonly property string wp: Config.appearance.wallpaper
    readonly property bool dark: Config.appearance.darkMode
    readonly property string scheme: Config.appearance.scheme
    onWpChanged: regen()
    onDarkChanged: regen()
    onSchemeChanged: regen()
    onAccentOverrideChanged: regen()

    // Source of the palette, in priority order:
    //   1. the accent color from Settings (whole palette is built around it)
    //   2. the wallpaper image
    //   3. a default seed color (so scheme + dark mode still work with no wallpaper chosen)
    function buildCmd() {
        // read the config directly: the `overridden` binding can still be stale inside a change handler
        const acc = Config.appearance.accentOverride;
        const tail = ["--json", "hex", "--dry-run", "-m", dark ? "dark" : "light", "-t", scheme];
        if (/^#[0-9a-fA-F]{6}$/.test(acc)) return ["matugen", "color", "hex", acc].concat(tail);
        // --source-color-index 0: without it matugen asks interactively which color to use ("not a terminal" error)
        if (wp !== "") return ["matugen", "image", wp, "--source-color-index", "0"].concat(tail);
        return ["matugen", "color", "hex", "#a8c7fa"].concat(tail);
    }
    // debounced: several settings can change at once
    function regen() { regenT.restart() }
    Timer { id: regenT; interval: 150; onTriggered: { gen.running = false; gen.command = root.buildCmd(); gen.running = true } }

    Process {
        id: gen
        stdout: StdioCollector { onStreamFinished: root.parse(text) }
        stderr: StdioCollector { onStreamFinished: if (text.trim() !== "") console.warn("Theme: matugen says:", text.trim()) }
        onExited: (code, status) => { if (code !== 0) console.warn("Theme: matugen exited with", code, "running:", gen.command.join(" ")) }
    }

    // matugen 2.x:  colors.<mode>.<role>            = "#hex"
    // matugen 3.x:  colors.<role>.<mode|default>    = "#hex"  (or {color: "#hex"})
    function pick(c, key) {
        const m = dark ? "dark" : "light";
        let v = c[m] ? c[m][key] : undefined;
        if (v === undefined && c[key] !== undefined) {
            const e = c[key];
            v = (typeof e === "object" && e !== null) ? (e[m] !== undefined ? e[m] : e["default"]) : e;
        }
        if (v && typeof v === "object") v = v.color !== undefined ? v.color : v.hex;
        return typeof v === "string" ? v : undefined;
    }

    function parse(text) {
        try {
            const a = text.indexOf("{"), b = text.lastIndexOf("}");     // ignore any log lines around the JSON
            const j = JSON.parse(text.substring(a, b + 1));
            const c = j.colors || j;
            const set = (prop, key) => { const x = pick(c, key); if (x) root[prop] = x; };
            set("genPrimary", "primary");  set("genPrimaryFg", "on_primary");
            set("secondary", "secondary"); set("tertiary", "tertiary");
            set("surface", "surface");     set("surfaceContainer", "surface_container");
            set("surfaceContainerHigh", "surface_container_high");
            set("surfaceFg", "on_surface"); set("surfaceFgDim", "on_surface_variant");
            set("outline", "outline");
            console.log("Theme: applied", scheme, dark ? "dark" : "light", "primary", String(genPrimary));
        } catch (e) { console.warn("Theme: matugen output not understood:", e, "|", text.substring(0, 300)) }
    }

    Component.onCompleted: regen()
}
