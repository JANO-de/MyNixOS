// Niri configuration for iNiR shell
input {
    keyboard {
        xkb {
            layout "es"
            variant "nodeadkeys"
            options "compose:rctrl"
        }
        numlock
    }

    mouse {
        accel-profile "adaptive"
    }

    touchpad {
        tap
        natural-scroll
        dwt
    }

    focus-follows-mouse
}

output "HDMI-A-1" {
    mode "3840x2160@60.030"
    scale 1.5
    position x=0 y=0
}

output "eDP-1" {
    scale 1
    position x=2560 y=0
}

window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
}

window-rule {
    draw-border-with-background false
}

layout {
    gaps 20
    center-focused-column "never"

    focus-ring {
        width 4
        active-color "@FOCUS@"
        inactive-color "@FOCUS_INACTIVE@"
    }

    border {
        off
    }

    shadow {
        on
        softness 30
        spread 5
        offset x=0 y=5
        color "#0007"
    }

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width {
        proportion 1.0
    }
}

hotkey-overlay {
    skip-at-startup
}

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

binds {
    Mod+D { spawn "fuzzel"; }
    Mod+Return { spawn "alacritty"; }

    Mod+Shift+K { show-hotkey-overlay; }
    Mod+Shift+E { quit; }
    Ctrl+Alt+Delete { quit; }

    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1+ -l 1.0"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1-"; }
    XF86AudioMute allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }

    XF86MonBrightnessDown allow-when-locked=true { spawn-sh "brightnessctl set 5%-"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn-sh "brightnessctl set 5%+"; }

    Mod+Q repeat=false { close-window; }

    Mod+Left { focus-column-left; }
    Mod+Down { focus-window-down; }
    Mod+Up { focus-window-up; }
    Mod+Right { focus-column-right; }

    Mod+Space repeat=false { spawn "qs -c inir ipc call search toggle"; }
    Mod+Comma repeat=false { spawn "qs -c inir ipc call settings toggle"; }
    Mod+Shift+W repeat=false { spawn "qs -c inir ipc call panelFamily switch"; }
    Mod+A repeat=false { spawn "qs -c inir ipc call sidebarLeft toggle"; }
    Mod+N repeat=false { spawn "qs -c inir ipc call sidebarRight toggle"; }
    Mod+V repeat=false { spawn "qs -c inir ipc call cliphistService update"; }
    Print { spawn "qs -c inir ipc call region screenshot"; }
    Mod+Shift+S { spawn "qs -c inir ipc call region search"; }
    Mod+M repeat=false { spawn "qs -c inir ipc call mediaControls toggle"; }
    Mod+Ctrl+L repeat=false { spawn "qs -c inir ipc call lock activate"; }
    Mod+Shift+Q repeat=false { spawn "qs -c inir ipc call session toggle"; }
    Mod+B repeat=false { spawn "qs -c inir ipc call bar toggle"; }
    Mod+Slash repeat=false { spawn "qs -c inir ipc call cheatsheet toggle"; }
}

spawn-at-startup "polkit-gnome-authentication-agent-1"
spawn-at-startup "awww-daemon"
spawn-at-startup "qs -c inir"