// Niri configuration — managed declaratively by home-manager
// Validated at build time with `niri validate`.
// Colors come from the central theme via the FOCUS placeholders.
// The EDP_SCALE, TABLET_INPUT, TABLET_TOP and TABLET_BINDS placeholders are
// filled in by whichever host uses this config (see modules/home/niri.nix);
// the tablet-only ones expand to nothing on the laptop and desktop.

@TABLET_TOP@

input {
    keyboard {
        xkb {
            layout "es"
            variant "nodeadkeys"
            options "compose:rctrl"
        }
        numlock
    }

    mouse {
        // accel-profile "adaptive" is the default (as in KDE).
        // Remove "flat" so the cursor accelerates naturally.
    }

    touchpad {
        tap
        natural-scroll
        dwt
    }

@TABLET_INPUT@
    focus-follows-mouse
}

// --- Monitor output configuration ---
// HDMI-A-1 is shared between two monitors: the 4K at home and the 1920x1080 at
// school. No mode is declared here on purpose, so niri picks the native mode of
// whichever is connected, and unpositioned outputs are auto-placed.
//
// This file deliberately declares NO `output` blocks. Niri merges an output
// block found in an include with one from the main config, later keys winning,
// so Monitor Manager writes here would silently override this file rather than
// fail loudly. Keeping one owner avoids that ambiguity. Output settings live
// only in the optional include at the bottom of this file, which the Monitor
// Manager GUI owns; the saved profiles are what replace the old per-location
// presets:
//
//   school  HDMI-A-1 scale 1, position x=0 y=0 (eDP-1 auto-placed to its right)
//   home    HDMI-A-1 scale 1.5, position x=0 y=0 (4K)


window-rule {
    match title="Kando Menu"
    open-floating true
    focus-ring { off; }
    border { off; }
    shadow { off; }
    default-floating-position x=0 y=0
}

window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
}

window-rule {
    draw-border-with-background false
}


layout {
    gaps 20
    center-focused-column "never"

    focus-ring {
        width 4
        active-color "@FOCUS@"
        inactive-color "@FOCUS_INACTIVE@"
    }

    border {
        off
    }

    shadow {
        on
        softness 30
        spread 5
        offset x=0 y=5
        color "#0007"
    }

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width {
        proportion 1.0
    }
}

hotkey-overlay {
    skip-at-startup
}

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

binds {
    Mod+Return { spawn "alacritty"; }
    Mod+E { spawn "alacritty" "-e" "yazi"; }

    // --- iNiR shell (merged from reference niri/config.kdl) ---
    Mod+W      { spawn "inir" "wallpaperSelector" "toggle"; }   // was: toggle-column-tabbed-display -> Mod+Shift+T
    Mod+Shift+T { toggle-column-tabbed-display; }
    Mod+Space  { spawn "inir" "overview" "toggle"; }
    Super+Tab  { toggle-overview; }
    Mod+Shift+W { spawn "inir" "panelFamily" "cycle"; }
    Mod+V      { spawn "inir" "clipboard" "toggle"; }          // was: toggle-window-floating -> Mod+Ctrl+V
    Mod+Ctrl+V { toggle-window-floating; }
    Mod+Comma  { spawn "inir" "settings"; }
    Mod+Ctrl+M { spawn "inir-monitor-manager"; }
    Mod+Ctrl+K  { spawn "inir" "cheatsheet" "toggle"; }
    Mod+Shift+S { spawn "inir" "region" "screenshot"; }
    Mod+Shift+X { spawn "inir" "region" "ocr"; }
    Mod+B      { spawn "zen"; }
    // --- /iNiR ---

    Mod+Shift+K { show-hotkey-overlay; }
    Mod+Shift+E { quit; }
    Ctrl+Alt+Delete { quit; }

@TABLET_BINDS@

    //XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "noctalia msg volume-up"; }
    //XF86AudioLowerVolume allow-when-locked=true { spawn-sh "noctalia msg volume-down"; }
    //XF86AudioMute        allow-when-locked=true { spawn-sh "noctalia msg volume-mute"; }
    XF86AudioMicMute     allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }

    //XF86MonBrightnessDown allow-when-locked=true { spawn-sh "noctalia msg brightness-down"; }
    //XF86MonBrightnessUp   allow-when-locked=true { spawn-sh "noctalia msg brightness-up"; }
    XF86AudioPrev         allow-when-locked=true { spawn-sh "playerctl previous"; }
    XF86AudioPlay         allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioPause        allow-when-locked=true { spawn-sh "playerctl pause"; }
    XF86AudioNext         allow-when-locked=true { spawn-sh "playerctl next"; }
    XF86AudioStop         allow-when-locked=true { spawn-sh "playerctl stop"; }

    Mod+Q repeat=false { close-window; }

    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+Right { focus-column-right; }
    Mod+H     { focus-column-left; }
    Mod+J     { focus-window-down; }
    Mod+K     { focus-window-up; }
    Mod+L     { focus-column-right; }

    Mod+Ctrl+Left  { move-column-left; }
    Mod+Ctrl+Down  { move-window-down; }
    Mod+Ctrl+Up    { move-window-up; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+H     { move-column-left; }
    Mod+Ctrl+J     { move-window-down; }

    Mod+Shift+Left  { focus-monitor-left; }
    Mod+Shift+Down  { focus-monitor-down; }
    Mod+Shift+Up    { focus-monitor-up; }
    Mod+Shift+Right { focus-monitor-right; }
    Mod+Shift+H     { focus-monitor-left; }
    Mod+Shift+J     { focus-monitor-down; }
    Mod+Shift+Z     { focus-monitor-up; }

    Mod+Shift+Ctrl+Left  { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Down  { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+Up    { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+H     { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+J     { move-column-to-monitor-down; }

    Mod+Page_Down      { focus-workspace-down; }
    Mod+Page_Up        { focus-workspace-up; }
    Mod+U              { focus-workspace-down; }
    Mod+I              { focus-workspace-up; }
    Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up   { move-column-to-workspace-up; }
    Mod+Ctrl+U         { move-column-to-workspace-down; }
    Mod+Ctrl+I         { move-column-to-workspace-up; }

    Mod+Shift+Page_Down { move-workspace-down; }
    Mod+Shift+Page_Up   { move-workspace-up; }
    Mod+Shift+U         { move-workspace-down; }
    Mod+Shift+I         { move-workspace-up; }

    Mod+WheelScrollDown      cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp        cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+Ctrl+6 { move-column-to-workspace 6; }
    Mod+Ctrl+7 { move-column-to-workspace 7; }
    Mod+Ctrl+8 { move-column-to-workspace 8; }
    Mod+Ctrl+9 { move-column-to-workspace 9; }

    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+Period { expel-window-from-column; }

    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-window-height; }
    Mod+Ctrl+R { reset-window-height; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+Ctrl+F { expand-column-to-available-width; }

    Mod+C { center-column; }
    Mod+Ctrl+C { center-visible-columns; }

    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    Mod+Shift+V { switch-focus-between-floating-and-tiling; }

    Home { screenshot; }
    Ctrl+Home { screenshot-screen; }
    Alt+Home { screenshot-window; }

    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    Mod+Shift+P { power-off-monitors; }
}

spawn-at-startup "polkit-gnome-authentication-agent-1"

// Allows notification actions and window activation from Noctalia
debug {
    honor-xdg-activation-with-invalid-serial
}

// --- iNiR shell hooks (from reference niri/config.kdl) ---
// iNiR's wallpaper/background layers must sit in the backdrop layer, behind
// every window, or the desktop art won't render at all.
layer-rule {
    match namespace="^quickshell:(iiBackdrop|wBackdrop)$"
    place-within-backdrop true
}

environment {
    ELECTRON_OZONE_PLATFORM_HINT "wayland"
    QT_IMAGEIO_MAXALLOC "0"
}

// --- Monitor Manager ---
// Written by the Monitor Manager GUI (see modules/desktop/shell/scripts/
// monitor-manager.py). The blocks above define the declarative defaults; this
// optional include is evaluated last so the GUI's output blocks override them.
// `optional=true` keeps the config valid while the file does not exist yet, and
// niri watches it, so saving from the GUI live-reloads the compositor.
include optional=true "config.d/15-outputs.kdl"
// --- /Monitor Manager ---
// --- /iNiR ---